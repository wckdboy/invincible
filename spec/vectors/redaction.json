{
  "spec": "redaction",
  "version": 1,
  "cases": [
    {
      "name": "an email",
      "input": "write to alice@proton.me today",
      "expect": {
        "text": "write to [EMAIL_1] today",
        "found": {
          "EMAIL": 1
        }
      }
    },
    {
      "name": "the same email twice, any case, is one placeholder",
      "input": "mail ALICE@proton.me or alice@proton.me",
      "expect": {
        "text": "mail [EMAIL_1] or [EMAIL_1]",
        "found": {
          "EMAIL": 1
        }
      }
    },
    {
      "name": "two emails are numbered in order",
      "input": "bob@posteo.de and carol@riseup.net",
      "expect": {
        "text": "[EMAIL_1] and [EMAIL_2]",
        "found": {
          "EMAIL": 2
        }
      }
    },
    {
      "name": "an email after mailto: is found",
      "input": "mailto:bob@proton.me",
      "expect": {
        "text": "mailto:[EMAIL_1]",
        "found": {
          "EMAIL": 1
        }
      }
    },
    {
      "name": "a Unicode email",
      "input": "écris à zoë@exemple.fr",
      "expect": {
        "text": "écris à [EMAIL_1]",
        "found": {
          "EMAIL": 1
        }
      }
    },
    {
      "name": "git@ is not an email",
      "input": "clone git@github.com:me/repo",
      "expect": {
        "text": "clone git@github.com:me/repo",
        "found": {}
      }
    },
    {
      "name": "an image name is not an email",
      "input": "see logo@2x.png",
      "expect": {
        "text": "see logo@2x.png",
        "found": {}
      }
    },
    {
      "name": "example domains are not emails",
      "input": "alice@example.com, bob@mail.example.org, x@host.test",
      "expect": {
        "text": "alice@example.com, bob@mail.example.org, x@host.test",
        "found": {}
      }
    },
    {
      "name": "a spaced IBAN",
      "input": "IBAN DE89 3704 0044 0532 0130 00 please",
      "expect": {
        "text": "IBAN [IBAN_1] please",
        "found": {
          "IBAN": 1
        }
      }
    },
    {
      "name": "an IBAN is cut at its country's length",
      "input": "GB82 WEST 1234 5698 7654 32 OK",
      "expect": {
        "text": "[IBAN_1] OK",
        "found": {
          "IBAN": 1
        }
      }
    },
    {
      "name": "an IBAN with a wrong checksum is kept",
      "input": "DE88 3704 0044 0532 0130 00",
      "expect": {
        "text": "DE88 3704 0044 0532 0130 00",
        "found": {}
      }
    },
    {
      "name": "a spaced and a compact IBAN are one value",
      "input": "DE89 3704 0044 0532 0130 00 = DE89370400440532013000",
      "expect": {
        "text": "[IBAN_1] = [IBAN_1]",
        "found": {
          "IBAN": 1
        }
      }
    },
    {
      "name": "a card number",
      "input": "card 4111 1111 1111 1111, thanks",
      "expect": {
        "text": "card [CARD_1], thanks",
        "found": {
          "CARD": 1
        }
      }
    },
    {
      "name": "a card number with dashes",
      "input": "5555-5555-5555-4444",
      "expect": {
        "text": "[CARD_1]",
        "found": {
          "CARD": 1
        }
      }
    },
    {
      "name": "a card number failing Luhn is kept",
      "input": "4111 1111 1111 1112",
      "expect": {
        "text": "4111 1111 1111 1112",
        "found": {}
      }
    },
    {
      "name": "one digit repeated is not a card",
      "input": "4444 4444 4444 4444",
      "expect": {
        "text": "4444 4444 4444 4444",
        "found": {}
      }
    },
    {
      "name": "digits inside a longer number are not a card",
      "input": "order 41111111111111110000",
      "expect": {
        "text": "order 41111111111111110000",
        "found": {}
      }
    },
    {
      "name": "a card number in inline code is kept",
      "input": "test with `4111 1111 1111 1111`",
      "expect": {
        "text": "test with `4111 1111 1111 1111`",
        "found": {}
      }
    },
    {
      "name": "a card number in a fenced block is kept",
      "input": "```\n4111 1111 1111 1111\n```",
      "expect": {
        "text": "```\n4111 1111 1111 1111\n```",
        "found": {}
      }
    },
    {
      "name": "an international phone",
      "input": "call +44 20 7946 0958",
      "expect": {
        "text": "call [PHONE_1]",
        "found": {
          "PHONE": 1
        }
      }
    },
    {
      "name": "one phone written two ways is one value",
      "input": "+49 30 1234567 or +49-30-1234567",
      "expect": {
        "text": "[PHONE_1] or [PHONE_1]",
        "found": {
          "PHONE": 1
        }
      }
    },
    {
      "name": "North American phones",
      "input": "Call (415) 555-0132 or 415.555.0199",
      "expect": {
        "text": "Call [PHONE_1] or [PHONE_2]",
        "found": {
          "PHONE": 2
        }
      }
    },
    {
      "name": "a national phone before a full stop",
      "input": "Ruf an: 030 1234567.",
      "expect": {
        "text": "Ruf an: [PHONE_1].",
        "found": {
          "PHONE": 1
        }
      }
    },
    {
      "name": "a national phone without spaces",
      "input": "Handy 01701234567",
      "expect": {
        "text": "Handy [PHONE_1]",
        "found": {
          "PHONE": 1
        }
      }
    },
    {
      "name": "a phone in a link is kept",
      "input": "https://x.org/call/+4930123456",
      "expect": {
        "text": "https://x.org/call/+4930123456",
        "found": {}
      }
    },
    {
      "name": "a plus after a letter is not a phone",
      "input": "x+4930123456",
      "expect": {
        "text": "x+4930123456",
        "found": {}
      }
    },
    {
      "name": "a date is not a phone",
      "input": "due 2026-10-18",
      "expect": {
        "text": "due 2026-10-18",
        "found": {}
      }
    },
    {
      "name": "an IP address is not a phone",
      "input": "server 10.0.0.1 is up",
      "expect": {
        "text": "server 10.0.0.1 is up",
        "found": {}
      }
    },
    {
      "name": "a date after a country code is not a phone",
      "input": "+49 2026.10.18",
      "expect": {
        "text": "+49 2026.10.18",
        "found": {}
      }
    },
    {
      "name": "placeholder-shaped text keeps its number",
      "input": "I wrote [EMAIL_1] literally; mine is carol@posteo.de",
      "expect": {
        "text": "I wrote [EMAIL_1] literally; mine is [EMAIL_2]",
        "found": {
          "EMAIL": 1
        }
      }
    },
    {
      "name": "every kind in one text",
      "input": "Pay DE89 3704 0044 0532 0130 00 from card 4111 1111 1111 1111, call +44 20 7946 0958 or mail dan@tuta.io",
      "expect": {
        "text": "Pay [IBAN_1] from card [CARD_1], call [PHONE_1] or mail [EMAIL_1]",
        "found": {
          "EMAIL": 1,
          "IBAN": 1,
          "CARD": 1,
          "PHONE": 1
        }
      }
    },
    {
      "name": "nothing to find",
      "input": "What is the capital of France?",
      "expect": {
        "text": "What is the capital of France?",
        "found": {}
      }
    },
    {
      "name": "a name after a relation",
      "input": "My sister Hannah called",
      "expect": {
        "text": "My sister [PERSON_1] called",
        "found": {
          "PERSON": 1
        }
      }
    },
    {
      "name": "a German relation",
      "input": "Meine Schwester Lena kommt",
      "expect": {
        "text": "Meine Schwester [PERSON_1] kommt",
        "found": {
          "PERSON": 1
        }
      }
    },
    {
      "name": "a name after an honorific",
      "input": "Dr. Weber will see you",
      "expect": {
        "text": "Dr. [PERSON_1] will see you",
        "found": {
          "PERSON": 1
        }
      }
    },
    {
      "name": "a name in a greeting",
      "input": "Hi Lea Wolf,\nthanks",
      "expect": {
        "text": "Hi [PERSON_1],\nthanks",
        "found": {
          "PERSON": 1
        }
      }
    },
    {
      "name": "a name in a sign-off",
      "input": "See you soon.\nBest regards,\nXaver Huber",
      "expect": {
        "text": "See you soon.\nBest regards,\n[PERSON_1]",
        "found": {
          "PERSON": 1
        }
      }
    },
    {
      "name": "a name after named",
      "input": "a guy named Zork",
      "expect": {
        "text": "a guy named [PERSON_1]",
        "found": {
          "PERSON": 1
        }
      }
    },
    {
      "name": "a name after I'm",
      "input": "I'm Zork Blax, nice to meet you",
      "expect": {
        "text": "I'm [PERSON_1], nice to meet you",
        "found": {
          "PERSON": 1
        }
      }
    },
    {
      "name": "I'm Sorry is not a name",
      "input": "I'm Sorry",
      "expect": {
        "text": "I'm Sorry",
        "found": {}
      }
    },
    {
      "name": "a listed first name with its surname",
      "input": "Mark Twain wrote it",
      "expect": {
        "text": "[PERSON_1] wrote it",
        "found": {
          "PERSON": 1
        }
      }
    },
    {
      "name": "a surname with particles",
      "input": "Meet Jan van der Berg tomorrow",
      "expect": {
        "text": "Meet [PERSON_1] tomorrow",
        "found": {
          "PERSON": 1
        }
      }
    },
    {
      "name": "a possessive stays outside the name",
      "input": "Hannah's bike",
      "expect": {
        "text": "[PERSON_1]'s bike",
        "found": {
          "PERSON": 1
        }
      }
    },
    {
      "name": "an ambiguous first name alone is not a name",
      "input": "Will you join?",
      "expect": {
        "text": "Will you join?",
        "found": {}
      }
    },
    {
      "name": "a first name before a blocked word is not a name",
      "input": "Max tokens is 512",
      "expect": {
        "text": "Max tokens is 512",
        "found": {}
      }
    },
    {
      "name": "Grace Period is not a name",
      "input": "Grace Period applies",
      "expect": {
        "text": "Grace Period applies",
        "found": {}
      }
    },
    {
      "name": "a surname alone later is the same person's part",
      "input": "I talked to Hannah Weber. Later Weber called back.",
      "expect": {
        "text": "I talked to [PERSON_1]. Later [PERSON_2] called back.",
        "found": {
          "PERSON": 2
        }
      }
    },
    {
      "name": "a name in inline code is kept",
      "input": "run `Hannah` now",
      "expect": {
        "text": "run `Hannah` now",
        "found": {}
      }
    },
    {
      "name": "an English street address",
      "input": "Ship it to 221B Baker Street, London please",
      "expect": {
        "text": "Ship it to [ADDRESS_1] please",
        "found": {
          "ADDRESS": 1
        }
      }
    },
    {
      "name": "a German street address",
      "input": "Ich wohne in der Hauptstraße 12a, 10115 Berlin.",
      "expect": {
        "text": "Ich wohne in der [ADDRESS_1].",
        "found": {
          "ADDRESS": 1
        }
      }
    },
    {
      "name": "a French street address",
      "input": "12 rue de la Paix, 75002 Paris",
      "expect": {
        "text": "[ADDRESS_1]",
        "found": {
          "ADDRESS": 1
        }
      }
    },
    {
      "name": "an Italian street address",
      "input": "Via Roma 10",
      "expect": {
        "text": "[ADDRESS_1]",
        "found": {
          "ADDRESS": 1
        }
      }
    },
    {
      "name": "a cued customer number",
      "input": "My customer number is 4711-0815-22",
      "expect": {
        "text": "My customer number is [ACCOUNT_1]",
        "found": {
          "ACCOUNT": 1
        }
      }
    },
    {
      "name": "a cued social security number",
      "input": "SSN 123-45-6789",
      "expect": {
        "text": "SSN [ACCOUNT_1]",
        "found": {
          "ACCOUNT": 1
        }
      }
    },
    {
      "name": "a social security number without a cue",
      "input": "it is 123-45-6789.",
      "expect": {
        "text": "it is [ACCOUNT_1].",
        "found": {
          "ACCOUNT": 1
        }
      }
    },
    {
      "name": "a year after a cue is not an account",
      "input": "policy since 2019",
      "expect": {
        "text": "policy since 2019",
        "found": {}
      }
    },
    {
      "name": "a cued phone number",
      "input": "phone: 555 0199 22",
      "expect": {
        "text": "phone: [PHONE_1]",
        "found": {
          "PHONE": 1
        }
      }
    },
    {
      "name": "numbering continues after the highest literal placeholder",
      "input": "Template says [EMAIL_3]; mine is carol@posteo.de",
      "expect": {
        "text": "Template says [EMAIL_3]; mine is [EMAIL_4]",
        "found": {
          "EMAIL": 1
        }
      }
    }
  ]
}
