      "input": {
        "kind": "link",
        "network": "offline",
        "host": "127.0.0.1"
      },
      "expect": {
        "action": "direct"
      }
    },
    {
      "name": "link: loopback by name",
      "input": {
        "kind": "link",
        "network": "offline",
        "host": "localhost"
      },
      "expect": {
        "action": "direct"
      }
    },
    {
