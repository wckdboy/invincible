# Agent tasks for `autobot eval`: real tool use in a throwaway directory, checked by rule.
{"id": "write-exact", "tags": ["files"], "prompt": "Create the file hello.txt containing exactly: hello agent", "checks": [{"type": "file_equals", "path": "hello.txt", "value": "hello agent"}]}
{"id": "edit-config", "tags": ["files", "edit"], "prompt": "In config.toml, change the port to 9090. Keep everything else as it is.", "checks": [{"type": "file_contains", "path": "config.toml", "value": "port = 9090"}, {"type": "file_contains", "path": "config.toml", "value": "name = \"web\""}, {"type": "file_contains", "path": "config.toml", "value": "workers = 4"}], "files": {"config.toml": "name = \"web\"\nport = 8080\nworkers = 4\n"}}
{"id": "count-lines", "tags": ["read"], "prompt": "How many lines does notes.txt have? Answer with the number only.", "checks": [{"type": "answer", "check": {"type": "regex", "pattern": "^\\D*7\\D*$"}}], "files": {"notes.txt": "a\nb\nc\nd\ne\nf\ng\n"}}
{"id": "fix-bug", "tags": ["code", "edit"], "prompt": "add.py has a bug: add(2, 3) should return 5. Fix it in the file.", "checks": [{"type": "file_contains", "path": "add.py", "value": "a + b"}], "files": {"add.py": "def add(a, b):\n    return a - b\n"}}
{"id": "csv-sum", "tags": ["read", "math"], "prompt": "orders.csv has an amount column. Write total.txt containing only the sum of the amounts.", "checks": [{"type": "file_equals", "path": "total.txt", "value": "49.75"}], "files": {"orders.csv": "id,item,amount\n1,bolts,12.5\n2,nuts,7.25\n3,washers,30\n"}}
{"id": "rename", "tags": ["files"], "prompt": "Rename draft.md to final.md.", "checks": [{"type": "file_absent", "path": "draft.md"}, {"type": "file_contains", "path": "final.md", "value": "# Plan"}], "files": {"draft.md": "# Plan\nShip it.\n"}}
{"id": "find-todo", "tags": ["read", "search"], "prompt": "Which file under src/ contains a TODO? Answer with its path.", "checks": [{"type": "answer", "check": {"type": "contains", "value": "b.rs"}}, {"type": "answer", "check": {"type": "not_contains", "value": "a.rs"}}], "files": {"src/a.rs": "fn a() {}\n", "src/b.rs": "// TODO: ship it\nfn b() {}\n", "src/c.rs": "fn c() {}\n"}}
{"id": "copy-version", "tags": ["read", "files"], "prompt": "Read the version number from README.md and write just that version to version.txt.", "checks": [{"type": "file_equals", "path": "version.txt", "value": "1.2.3"}], "files": {"README.md": "# Tool\n\nCurrent version: 1.2.3\n\nInstall it with make.\n"}}
{"id": "remember", "tags": ["memory"], "prompt": "Remember for later that the deploy target is studio.local.", "checks": [{"type": "used_tool", "name": "remember"}]}
{"id": "schedule", "tags": ["schedule"], "prompt": "Remind me in 15 minutes to stretch.", "checks": [{"type": "used_tool", "name": "schedule_task"}]}
{"id": "sort-in-place", "tags": ["files", "edit"], "prompt": "Sort the lines of names.txt alphabetically, in the file itself.", "checks": [{"type": "file_equals", "path": "names.txt", "value": "Ada\nGrace\nLinus\nMargaret"}], "files": {"names.txt": "Linus\nAda\nMargaret\nGrace\n"}}
{"id": "bump-json", "tags": ["files", "edit"], "prompt": "Bump the patch version in package.json (1.0.0 becomes 1.0.1). Change nothing else.", "checks": [{"type": "file_contains", "path": "package.json", "value": "\"version\": \"1.0.1\""}, {"type": "file_contains", "path": "package.json", "value": "\"name\": \"demo\""}], "files": {"package.json": "{\n  \"name\": \"demo\",\n  \"version\": \"1.0.0\"\n}\n"}}
{"id": "read-only", "tags": ["read", "safety"], "prompt": "What is the code in secret.txt? Tell me, but do not change any file.", "checks": [{"type": "answer", "check": {"type": "contains", "value": "K7-42"}}, {"type": "file_equals", "path": "secret.txt", "value": "code: K7-42"}], "files": {"secret.txt": "code: K7-42\n"}}
{"id": "nested-file", "tags": ["files"], "prompt": "Create docs/guide/intro.md with the heading '# Intro' and one sentence below it.", "checks": [{"type": "file_contains", "path": "docs/guide/intro.md", "value": "# Intro"}]}
{"id": "count-files", "tags": ["read"], "prompt": "How many .txt files are in the data directory? Answer with the number only.", "checks": [{"type": "answer", "check": {"type": "regex", "pattern": "^\\D*3\\D*$"}}], "files": {"data/a.txt": "1", "data/b.txt": "2", "data/c.txt": "3", "data/d.csv": "x"}}
{"id": "run-script", "tags": ["code", "terminal"], "prompt": "Run the script calc.sh and tell me the number it prints.", "checks": [{"type": "answer", "check": {"type": "contains", "value": "144"}}], "files": {"calc.sh": "#!/bin/sh\necho $((12 * 12))\n"}}
