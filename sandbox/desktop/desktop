#!/bin/sh
# A knight's desktop: a display, a window manager and a browser in its own VM, and this one command to
# operate them. Every command but `help`, `status` and `stop` brings the desktop up first if it isn't.
# Nothing here is reachable from outside the VM: the display takes no network connections and the
# browser's debugging port (through which `text` reads a page) listens on loopback only.
set -u
export DISPLAY=:1
SIZE=1280x800
RUN=${GALAHAD_DESKTOP_RUN:-/tmp/galahad-desktop}
WAIT=${GALAHAD_DESKTOP_WAIT:-20}
PROFILE="$HOME/.config/chromium"

usage() {
  cat <<'HELP'
desktop start                      bring up the display, the window manager and the browser
desktop status | desktop stop
desktop open <address>             open an address in the browser (http, https, file or about)
desktop text                       the page in front, as text: its title, its address, what it says
desktop shot [file.png]            a screenshot of the whole display; prints the file's path
desktop look "<question>"          ask a model that can see what is on the screen, or where something
                                   is (it answers a place as x,y, to click or move to)
desktop click <x> <y> [left|right|middle|double]
desktop move <x> <y>
desktop scroll <up|down> [times]
desktop type <text>                type text where the keyboard's focus is
desktop key <key>...               press keys, e.g. Return, Tab, Escape, ctrl+l, ctrl+a, alt+Left
The display is 1280 by 800; x runs right from 0, y runs down from 0.
HELP
}
fail() { echo "desktop: $1" >&2; exit "${2:-1}"; }
refuse() { echo "desktop: $1" >&2; exit 2; }
whole() { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }

# Wait (up to WAIT seconds) for a check to hold.
until_true() {
  n=0
  while ! "$@" >/dev/null 2>&1; do
    n=$((n + 1))
    [ "$n" -gt $((WAIT * 10)) ] && return 1
    sleep 0.1
  done
}
display_up() { xdpyinfo -display "$DISPLAY"; }
browser_up() { pgrep -x chromium; }

start() {
  mkdir -p "$RUN" "$PROFILE"
  if ! display_up >/dev/null 2>&1; then
    Xvfb "$DISPLAY" -screen 0 "${SIZE}x24" -nolisten tcp >"$RUN/display.log" 2>&1 &
    until_true display_up || fail "the display did not come up (see $RUN/display.log)"
    openbox >"$RUN/windows.log" 2>&1 &
    sleep 0.3
  fi
  if ! browser_up >/dev/null 2>&1; then
    # Its own inner sandbox is off: the VM's restrictions (no new privileges, no capabilities) forbid it,
    # and the microVM is the boundary. Its profile is on the workspace, so what is signed in there stays
    # with this VM's disk.
    # (No "restore pages?" bubble: a VM made again ends its browser without a goodbye, every time.)
    chromium --user-data-dir="$PROFILE" --no-sandbox --test-type --no-first-run --no-default-browser-check --hide-crash-restore-bubble \
      --disable-gpu --disable-dev-shm-usage --remote-debugging-port=9222 --remote-debugging-address=127.0.0.1 \
      --window-size="$(echo "$SIZE" | tr x ,)" --window-position=0,0 about:blank >"$RUN/browser.log" 2>&1 &
    until_true browser_up || fail "the browser did not start (see $RUN/browser.log)"
  fi
}

# The one page of the browser, through its debugging port (loopback only): `page navigate <address>` goes
# there, waits for it to load and prints its title and address; `page text` prints its title, its
# address and what it says. One page, so what is opened and what is read are the same thing.
page() {
  python3 - "$@" <<'PY'
import json, sys, time, urllib.request, websocket
PORT = "http://127.0.0.1:9222"
def pages():
    last = None
    for _ in range(100):
        try:
            return [t for t in json.load(urllib.request.urlopen(PORT + "/json", timeout=5)) if t.get("type") == "page"]
        except Exception as error:
            last = error
            time.sleep(0.2)
    raise SystemExit("desktop: the browser is not answering (%s)" % last)
found = pages()
if not found:
    urllib.request.urlopen(urllib.request.Request(PORT + "/json/new?about:blank", method="PUT"), timeout=10)
    found = pages()
ws = websocket.create_connection(found[0]["webSocketDebuggerUrl"], suppress_origin=True, timeout=30)
asked = 0
def call(method, **params):
    global asked
    asked += 1
    ws.send(json.dumps({"id": asked, "method": method, "params": params}))
    while True:
        reply = json.loads(ws.recv())
        if reply.get("id") == asked:
            return reply.get("result", {})
def value(expression):
    return call("Runtime.evaluate", expression=expression, returnByValue=True).get("result", {}).get("value", "")
if sys.argv[1] == "navigate":
    went = call("Page.navigate", url=sys.argv[2])
    if went.get("errorText"):
        raise SystemExit("desktop: the browser could not open that address (%s)" % went["errorText"])
    for _ in range(150):
        if value("document.readyState") == "complete":
            break
        time.sleep(0.2)
    print(value("document.title + ' · ' + location.href"))
else:
    print(value("document.title + '\\n' + location.href + '\\n' + (document.body ? document.body.innerText : '').slice(0, 20000)"))
PY
}

# The question and a fresh picture of the screen, put to the model named for this VM (GALAHAD_EYES, as
# provider/model) through the gateway this VM was given. The gateway's token is read from the
# environment here and is never an argument. What comes back is the model's words: data, not orders.
eyes() {
  python3 - "$@" <<'PY'
import base64, json, os, sys, urllib.error, urllib.request
provider, _, model = os.environ["GALAHAD_EYES"].partition("/")
picture = base64.b64encode(open(sys.argv[2], "rb").read()).decode()
framing = ("This is a screenshot of a desktop, 1280 pixels wide and 800 high: x runs right from 0 and y runs down from 0. "
           "Answer from what is on it and nothing else. When asked where something is, give the pixel coordinates of its "
           "centre as x,y; if it is not on the screen, say so.")
body = {"model": model, "max_tokens": 600, "messages": [{"role": "user", "content": [
    {"type": "text", "text": framing + "\n\n" + sys.argv[3]},
    {"type": "image_url", "image_url": {"url": "data:image/jpeg;base64," + picture}}]}]}
request = urllib.request.Request(os.environ["GALAHAD_GATEWAY"] + "/" + provider + "/chat/completions", data=json.dumps(body).encode(),
    headers={"authorization": "Bearer " + os.environ["GALAHAD_TOKEN"], "content-type": "application/json", "user-agent": "galahad-desktop/1"})
try:
    reply = json.load(urllib.request.urlopen(request, timeout=180))
except urllib.error.HTTPError as error:
    raise SystemExit("desktop: the model that looks could not answer (%s %s)" % (error.code, error.read().decode(errors="replace")[:300].replace("\n", " ")))
except Exception as error:
    raise SystemExit("desktop: the model that looks could not be reached (%s)" % error)
print((reply["choices"][0]["message"].get("content") or "").strip() or "(it said nothing)")
PY
}

verb=${1:-help}
[ $# -gt 0 ] && shift
case "$verb" in
  help | --help | -h) usage ;;
  start) start && echo "The desktop is up: $SIZE, display $DISPLAY." ;;
  status)
    if display_up >/dev/null 2>&1; then echo "The desktop is up: $SIZE, display $DISPLAY; the browser is $(browser_up >/dev/null 2>&1 && echo running || echo "not running")."
    else echo "The desktop is not up: desktop start"; fi ;;
  stop)
    pkill -x chromium 2>/dev/null; pkill -x openbox 2>/dev/null; pkill -x Xvfb 2>/dev/null
    echo "The desktop is stopped." ;;
  open)
    case "${1:-}" in http://* | https://* | file://* | about:*) ;; *) refuse "an address begins with http, https, file or about" ;; esac
    start && page navigate "$1" ;;
  text) start && page text ;;
  shot)
    file=${1:-"$RUN/shot-$(date +%s)$$.png"}
    start && scrot -o "$file" && echo "$file" ;;
  look)
    [ $# -ge 1 ] || refuse 'look takes a question: desktop look "<question>"'
    [ -n "${GALAHAD_EYES:-}" ] && [ -n "${GALAHAD_GATEWAY:-}" ] && [ -n "${GALAHAD_TOKEN:-}" ] || { echo "desktop: no model that can see is set for this VM (use desktop text to read a page, and desktop shot for a picture)" >&2; exit 3; }
    seen="$RUN/look-$(date +%s)$$.jpg"
    start && scrot -o "$seen" && eyes look "$seen" "$*"
    code=$?; rm -f "$seen"; exit "$code" ;;
  click)
    whole "${1:-}" && whole "${2:-}" || refuse "click takes two whole numbers: desktop click <x> <y> [left|right|middle|double]"
    case "${3:-left}" in
      left) set -- "$1" "$2" 1 ;; middle) set -- "$1" "$2" 2 ;; right) set -- "$1" "$2" 3 ;;
      double) set -- "$1" "$2" --repeat 2 1 ;;
      *) refuse "the button is left, right, middle or double" ;;
    esac
    x=$1; y=$2; shift 2
    start && xdotool mousemove "$x" "$y" click "$@" ;;
  move)
    whole "${1:-}" && whole "${2:-}" || refuse "move takes two whole numbers: desktop move <x> <y>"
    start && xdotool mousemove "$1" "$2" ;;
  scroll)
    case "${1:-}" in up) button=4 ;; down) button=5 ;; *) refuse "scroll goes up or down: desktop scroll <up|down> [times]" ;; esac
    times=${2:-1}
    whole "$times" && [ "$times" -ge 1 ] && [ "$times" -le 50 ] || refuse "scroll takes a whole number of times, from 1 to 50"
    start && xdotool click --repeat "$times" "$button" ;;
  type)
    [ $# -ge 1 ] || refuse "type takes the text to type: desktop type <text>"
    start && xdotool type --delay 12 -- "$*" ;;
  key)
    [ $# -ge 1 ] || refuse "keys are names like Return, Tab, Escape, ctrl+l: desktop key <key>..."
    for k in "$@"; do case "$k" in '' | *[!A-Za-z0-9_+]*) refuse "keys are names like Return, Tab, Escape, ctrl+l (letters, digits, _ and + only)" ;; esac; done
    start && xdotool key -- "$@" ;;
  *) usage >&2; exit 2 ;;
esac
