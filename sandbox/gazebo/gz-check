#!/usr/bin/env python3
"""gz-check: prove Gazebo works here by simulating something with a known answer.

A box dropped in vacuum, stepped 1000 times at 1 ms by DART: it falls
g·dt²·n(n+1)/2 = 4.9099 m (the integrator's exact answer; g/2 = 4.905 in the
limit).

    gz-check           a table, exit 1 if anything failed
"""
import os
import sys
import tempfile
import time

WORLD = """<?xml version="1.0"?><sdf version="1.9"><world name="check"><gravity>0 0 -9.81</gravity>
<physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>0</real_time_factor></physics>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<model name="box"><pose>0 0 10 0 0 0</pose><link name="link"><inertial><mass>1</mass></inertial>
<collision name="c"><geometry><box><size>0.1 0.1 0.1</size></box></geometry></collision>
<visual name="v"><geometry><box><size>0.1 0.1 0.1</size></box></geometry></visual></link></model>
</world></sdf>"""


def free_fall():
    import gz.math7  # noqa: F401
    from gz.sim8 import Link, Model, TestFixture, World, world_entity

    path = os.path.join(tempfile.mkdtemp(), "check.sdf")
    with open(path, "w") as f:
        f.write(WORLD)
    seen = {}

    def post(info, ecm):
        link = Link(Model(World(world_entity(ecm)).model_by_name(ecm, "box")).canonical_link(ecm))
        seen["z"] = link.world_pose(ecm).pos().z()

    fixture = TestFixture(path)
    fixture.on_post_update(post)
    fixture.finalize()
    fixture.server().run(True, 1000, False)
    fell = 10 - seen["z"]
    expected = 9.81 * 0.001**2 * 1000 * 1001 / 2
    assert abs(fell - expected) < 1e-6, f"fell {fell:.6f} m, expected {expected:.6f} m"
    return f"fell {fell:.4f} m"


CHECKS = [("Gazebo free fall", "1000 steps of 1 ms: 4.9099 m", free_fall)]


def main():
    passed = 0
    for name, reference, fn in CHECKS:
        started = time.perf_counter()
        try:
            detail, ok = fn(), True
        except Exception as error:  # noqa: BLE001 - every failure is a result here
            detail, ok = f"{type(error).__name__}: {error}"[:300], False
        passed += ok
        print(f"{'✓' if ok else '✗'} {name:<24} {detail:<32} ({reference}; {time.perf_counter() - started:.2f} s)")
    print(f"\n{passed}/{len(CHECKS)} checks passed")
    sys.exit(0 if passed == len(CHECKS) else 1)


if __name__ == "__main__":
    main()
