    x, y = cp.Variable(), cp.Variable()
    return close(cp.Problem(cp.Minimize(x + y), [x >= 1, y >= 2]).solve(), 3.0, 1e-6)


@check("Z3 (SMT)", "x+y=10, x−y=2 → x=6")
def _():
    import z3
    x, y = z3.Ints("x y")
    s = z3.Solver(); s.add(x + y == 10, x - y == 2)
    assert s.check() == z3.sat
    return f"x={s.model()[x]}"


@check("ngspice", "RC step: v(τ) = 1 − e⁻¹")
def _():
    deck = """rc
v1 in 0 pulse(0 1 0 1n 1n 1 2)
r1 in out 1k
c1 out 0 1u
.tran 1u 1m
.measure tran vt find v(out) at=1m
.end
"""
    with tempfile.NamedTemporaryFile("w", suffix=".cir", delete=False) as f:
        f.write(deck)
    out = run(["ngspice", "-b", f.name]).stdout
    line = next(l for l in out.splitlines() if l.strip().startswith("vt"))
    return close(float(line.split("=")[1].split()[0]), 1 - math.exp(-1), 2e-3)


