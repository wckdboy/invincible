@check("gmsh meshing", "unit square, triangles")
def _():
    import gmsh
    gmsh.initialize(["", "-v", "0"])
    try:
        gmsh.model.occ.addRectangle(0, 0, 0, 1, 1)
        gmsh.model.occ.synchronize()
        gmsh.option.setNumber("Mesh.MeshSizeMax", 0.1)
        gmsh.model.mesh.generate(2)
        n = len(gmsh.model.mesh.getElementsByType(2)[0])
        assert n > 100, f"only {n} triangles"
        return f"{n} triangles, gmsh {gmsh.__version__}"
    finally:
        gmsh.finalize()


@check("FEniCSx (dolfinx + PETSc)", "−Δu = 1 on the unit square: max u ≈ 0.07367")
def _():
    from mpi4py import MPI
    import numpy as np
    import ufl
    from dolfinx import fem, mesh
    from dolfinx.fem.petsc import LinearProblem
    domain = mesh.create_unit_square(MPI.COMM_SELF, 64, 64)
    V = fem.functionspace(domain, ("Lagrange", 2))
    facets = mesh.locate_entities_boundary(domain, 1, lambda x: np.full(x.shape[1], True))
    bc = fem.dirichletbc(0.0, fem.locate_dofs_topological(V, 1, facets), V)
    u, v = ufl.TrialFunction(V), ufl.TestFunction(V)
    a = ufl.inner(ufl.grad(u), ufl.grad(v)) * ufl.dx
    L = fem.Constant(domain, 1.0) * v * ufl.dx
    uh = LinearProblem(a, L, bcs=[bc], petsc_options={"ksp_type": "preonly", "pc_type": "lu"}).solve()
    return close(float(uh.x.array.max()), 0.0736713, 2e-3)


@check("scikit-fem", "same Poisson problem, P1")
def _():
    import skfem
    from skfem.helpers import dot, grad
    m = skfem.MeshTri().refined(6)
    basis = skfem.Basis(m, skfem.ElementTriP1())
    A = skfem.BilinearForm(lambda u, v, w: dot(grad(u), grad(v))).assemble(basis)
    b = skfem.LinearForm(lambda v, w: 1.0 * v).assemble(basis)
    x = skfem.solve(*skfem.condense(A, b, D=basis.get_dofs()))
    return close(float(x.max()), 0.0736713, 1e-2)


@check("OpenSees frames", "cantilever tip deflection PL³/3EI")
def _():
    import openseespy.opensees as ops
    E, I, A, L, P = 200e9, 8e-6, 1e-3, 2.0, 1000.0
    ops.wipe()
    ops.model("basic", "-ndm", 2, "-ndf", 3)
    ops.node(1, 0, 0); ops.node(2, L, 0); ops.fix(1, 1, 1, 1)
    ops.geomTransf("Linear", 1)
    ops.element("elasticBeamColumn", 1, 1, 2, A, E, I, 1)
    ops.timeSeries("Linear", 1); ops.pattern("Plain", 1, 1); ops.load(2, 0, -P, 0)
    for cmd in (("system", "BandGeneral"), ("numberer", "Plain"), ("constraints", "Plain"), ("integrator", "LoadControl", 1.0), ("algorithm", "Linear")):
        getattr(ops, cmd[0])(*cmd[1:])
    ops.analysis("Static"); ops.analyze(1)
    return close(-ops.nodeDisp(2, 2), P * L**3 / (3 * E * I), 1e-9)


@check("MuJoCo dynamics", "free fall for 1 s: Δz = g/2")
def _():
    import mujoco
    xml = '<mujoco><option timestep="0.0005" integrator="RK4"/><worldbody><body pos="0 0 100"><freejoint/><geom size=".1" mass="1"/></body></worldbody></mujoco>'
    model = mujoco.MjModel.from_xml_string(xml)
    data = mujoco.MjData(model)
    while data.time < 1.0 - 1e-9:
        mujoco.mj_step(model, data)
    return close(100 - data.qpos[2], 9.81 / 2, 1e-4)


