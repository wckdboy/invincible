def _():
    import control
    import numpy as np
    t, y = control.step_response(control.tf([1], [1, 1]), T=np.linspace(0, 1, 1001))
    return close(float(y[-1]), 1 - math.exp(-1), 1e-4)


@check("cvxpy", "min x+y, x≥1, y≥2 = 3")
def _():
