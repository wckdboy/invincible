@check("Cantera", "stoichiometric CH₄/air, adiabatic flame ≈ 2225 K")
def _():
    import cantera as ct
    gas = ct.Solution("gri30.yaml")
    gas.TP = 300, ct.one_atm
    gas.set_equivalence_ratio(1.0, "CH4", "O2:1, N2:3.76")
    gas.equilibrate("HP")
    return close(gas.T, 2225, 0.01)


