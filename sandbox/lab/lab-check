#!/opt/lab/bin/python3
"""lab-check: prove the Lab works by computing things with known answers.

Each check runs a small real computation and compares it with a reference
(analytic, or a well-established value), so a broken or silently wrong tool
shows up here, not halfway through an investigation.

    lab-check            a table, exit 1 if anything failed
    lab-check --json     machine-readable
"""
import json
import math
import os
import subprocess
import sys
import tempfile
import time

os.makedirs(os.environ.get("MPLCONFIGDIR", "/tmp/matplotlib"), exist_ok=True)
CHECKS = []


def check(name, reference):
    def wrap(fn):
        CHECKS.append((name, reference, fn))
        return fn
    return wrap


def close(value, expected, rel=1e-3, abs_=0.0):
    if not math.isclose(value, expected, rel_tol=rel, abs_tol=abs_):
        raise AssertionError(f"got {value:.6g}, expected {expected:.6g}")
    return f"{value:.6g}"


def run(cmd, timeout=60, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, **kw)


@check("numpy/scipy quadrature", "∫₀^π sin x dx = 2")
def _():
    from scipy.integrate import quad
    return close(quad(math.sin, 0, math.pi)[0], 2.0, 1e-12)


@check("sympy symbolics", "∫ x² e^x dx, d/dx back")
def _():
    import sympy as sp
    x = sp.symbols("x")
    f = x**2 * sp.exp(x)
    assert sp.simplify(sp.diff(sp.integrate(f, x), x) - f) == 0
    return "exact"


@check("units (Pint)", "1 m/s = 3.6 km/h")
def _():
    import pint
    u = pint.UnitRegistry()
    return close((1 * u.meter / u.second).to("km/h").magnitude, 3.6, 1e-12)


@check("uncertainty propagation", "σ(a·b) for a=2±0.1, b=3±0.2")
def _():
    from uncertainties import ufloat
    r = ufloat(2, 0.1) * ufloat(3, 0.2)
    return close(r.std_dev, math.hypot(3 * 0.1, 2 * 0.2), 1e-12)


@check("OpenCascade B-rep (build123d)", "box 10×20×30 minus Ø10 hole: 6000 − 750π mm³")
def _():
    from build123d import Box, Cylinder, export_step
    part = Box(10, 20, 30) - Cylinder(5, 30)
