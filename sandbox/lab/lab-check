@check("OpenFOAM", "lid-driven cavity (icoFoam tutorial) runs to its end time")
def _():
    import glob
    import shutil
    info = run(["openfoam"]).stdout
    found = glob.glob("/usr/share/**/incompressible/icoFoam/cavity/cavity", recursive=True)
    assert found, "the cavity tutorial isn't installed (openfoam-examples)"
    with tempfile.TemporaryDirectory() as d:
        case = os.path.join(d, "cavity")
        shutil.copytree(found[0], case)
        for step in (["openfoam", "blockMesh"], ["openfoam", "icoFoam"]):
            r = run(step, timeout=120, cwd=case)
            assert r.returncode == 0 and "End" in r.stdout, f"{step[1]}: {(r.stdout + r.stderr)[-300:]}"
        assert os.path.isdir(os.path.join(case, "0.5")), "no 0.5 time directory"
    return info.splitlines()[0].split(" (")[0]


@check("MPI", "4 ranks agree on the size")
def _():
    r = run(["mpirun", "-n", "4", sys.executable, "-c", "from mpi4py import MPI; print(MPI.COMM_WORLD.size)"], timeout=120)
    sizes = r.stdout.split()
    assert sizes == ["4"] * 4, (r.stdout + r.stderr)[-400:]
    return "4 ranks"


def main():
    results = []
    for name, reference, fn in CHECKS:
        started = time.perf_counter()
        try:
            detail, ok = fn(), True
        except Exception as error:  # noqa: BLE001 - every failure is a result here
            detail, ok = f"{type(error).__name__}: {error}"[:300], False
        results.append({"check": name, "reference": reference, "ok": ok, "detail": detail, "seconds": round(time.perf_counter() - started, 2)})
    if "--json" in sys.argv:
        print(json.dumps({"ok": all(r["ok"] for r in results), "checks": results}))
    else:
        for r in results:
            print(f"{'✓' if r['ok'] else '✗'} {r['check']:<32} {r['detail']:<40} ({r['reference']}; {r['seconds']} s)")
        failed = [r for r in results if not r["ok"]]
        print(f"\n{len(results) - len(failed)}/{len(results)} checks passed")
    sys.exit(0 if all(r["ok"] for r in results) else 1)


if __name__ == "__main__":
    main()
