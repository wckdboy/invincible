---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
---

<Base title="Not found · Invincible" description="There is nothing at this address." path="/404">
  <section class="wrap">
    <div class="lost">
      <Mark size={72} />
      <h1>Nothing is here.</h1>
      <p>My apologies: there is nothing at this address. <a href="/">The front page</a> has all there is: what Invincible is, the line that installs it, and the apps.</p>
    </div>
  </section>
</Base>
