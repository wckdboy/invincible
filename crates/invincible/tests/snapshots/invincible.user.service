[Unit]
Description=Invincible Gateway
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/me/.local/bin/invincible serve
Environment=PATH=/usr/bin
Restart=always
RestartSec=5
WatchdogSec=180
TimeoutStopSec=20
KillMode=mixed
LimitNOFILE=65536
StandardOutput=append:/home/me/.invincible/logs/gateway.log
StandardError=append:/home/me/.invincible/logs/gateway.log

[Install]
WantedBy=default.target
